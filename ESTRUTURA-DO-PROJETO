</div>
{% endblock %}

{% block scripts_extras %}
<script>
// Atualiza as cotações a cada 60 segundos sem recarregar a página
async function atualizarCotacoes() {
  try {
    const r = await fetch("/cotacoes/api");
    const d = await r.json();

    document.getElementById("status-atualizacao").textContent =
      "Atualizado: " + d.atualizado;

    // Atualiza cada valor dinamicamente
    const campos = {
      "cot-cdi":     { val: d.cdi.valor,     cls: d.cdi.ok ? "verde" : "" },
      "cot-selic":   { val: d.selic.valor,   cls: d.selic.ok ? "verde" : "" },
      "cot-ipca":    { val: d.ipca.valor,    cls: d.ipca.ok ? "amarelo" : "" },
      "cot-dolar":   { val: d.dolar.valor,   cls: d.dolar.ok ? "azul" : "" },
      "cot-euro":    { val: d.euro.valor,    cls: d.euro.ok ? "azul" : "" },
      "cot-bitcoin": { val: d.bitcoin.valor, cls: d.bitcoin.ok ? "amarelo" : "" },
    };
    for (const [id, info] of Object.entries(campos)) {
      const el = document.getElementById(id);
      if (el) { el.textContent = info.val; el.className = "cot-valor " + info.cls; }
    }
  } catch(e) {
    console.log("Erro ao atualizar cotações:", e);
  }
}

// Atualiza a cada 60 segundos
setInterval(atualizarCotacoes, 60000);
</script>
{% endblock %}
''')

