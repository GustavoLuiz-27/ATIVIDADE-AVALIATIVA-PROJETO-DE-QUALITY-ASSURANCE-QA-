criar_arquivo("tests/base_test.py", '''\
import unittest
from app import create_app, db
from app.models.user import User


class BaseTestCase(unittest.TestCase):

    def setUp(self):
        self.app = create_app()
        self.app.config.update({
            "TESTING": True,
            "SQLALCHEMY_DATABASE_URI": "sqlite:///:memory:",
            "SECRET_KEY": "chave-de-teste",
        })
        self.client = self.app.test_client()
        with self.app.app_context():
            db.create_all()

    def tearDown(self):
        with self.app.app_context():
            db.session.remove()
            db.drop_all()

    def criar_usuario(self, nome="Teste", email="teste@teste.com", senha="senha123", idade=15):
        with self.app.app_context():
            u = User(nome=nome, email=email, idade=idade)
            u.set_senha(senha)
            db.session.add(u)
            db.session.commit()

    def login(self, email="teste@teste.com", senha="senha123"):
        return self.client.post("/auth/login", data={"email": email, "senha": senha}, follow_redirects=True)

    def logout(self):
        return self.client.get("/auth/logout", follow_redirects=True)
''')

criar_arquivo("tests/test_auth.py", '''\
from tests.base_test import BaseTestCase


class TestCadastro(BaseTestCase):

    def test_cadastro_valido(self):
        r = self.client.post("/auth/cadastro", data={"nome":"Ana","email":"ana@teste.com","senha":"senha123","idade":16}, follow_redirects=True)
        self.assertEqual(r.status_code, 200)
        self.assertIn(b"sucesso", r.data.lower())

    def test_cadastro_email_duplicado(self):
        self.criar_usuario(email="ana@teste.com")
        r = self.client.post("/auth/cadastro", data={"nome":"Ana2","email":"ana@teste.com","senha":"senha123","idade":16}, follow_redirects=True)
        self.assertIn(b"cadastrado", r.data.lower())

    def test_senha_curta(self):
        r = self.client.post("/auth/cadastro", data={"nome":"X","email":"x@x.com","senha":"123","idade":15}, follow_redirects=True)
        self.assertNotIn(b"sucesso", r.data.lower())


class TestLogin(BaseTestCase):

    def setUp(self):
        super().setUp()
        self.criar_usuario()

    def test_login_correto(self):
        r = self.login()
        self.assertIn(b"dashboard", r.data.lower())

    def test_login_senha_errada(self):
        r = self.login(senha="errada")
        self.assertIn(b"incorretos", r.data.lower())

    def test_dashboard_sem_login(self):
        r = self.client.get("/dashboard", follow_redirects=True)
        self.assertIn(b"login", r.data.lower())
''')

criar_arquivo("tests/test_simulador.py", '''\
import unittest
from tests.base_test import BaseTestCase


class TestCalculoCDI(unittest.TestCase):

    def calcular(self, principal, meses, pct, taxa=0.1065):
        taxa_ef = taxa * (pct / 100)
        montante = principal * ((1 + taxa_ef) ** (meses / 12))
        return round(montante, 2), round(montante - principal, 2)

    def test_rendimento_positivo(self):
        _, rend = self.calcular(1000, 12, 100)
        self.assertGreater(rend, 0)

    def test_valor_zero(self):
        m, r = self.calcular(0, 12, 100)
        self.assertEqual(m, 0.0)

    def test_periodo_maior_rende_mais(self):
        _, r6  = self.calcular(1000, 6,  100)
        _, r12 = self.calcular(1000, 12, 100)
        self.assertLess(r6, r12)


class TestRotaSimulador(BaseTestCase):

    def setUp(self):
        super().setUp()
        self.criar_usuario()
        self.login()

    def test_pagina_carrega(self):
        r = self.client.get("/simular/")
        self.assertEqual(r.status_code, 200)

    def test_campo_invalido_nao_crasha(self):
        r = self.client.post("/simular/", data={"principal":"abc","meses":"12","percentual_cdi":"100"}, follow_redirects=True)
        self.assertNotEqual(r.status_code, 500)
''')

