criar_arquivo("app/routes/simulador.py", '''\
from flask import Blueprint, render_template, request
from flask_login import login_required

simulador_bp = Blueprint("simulador", __name__, url_prefix="/simular")

TAXA_CDI_ANUAL = 0.1065  # 10,65% ao ano (valor de referência)


def calcular_cdi(principal, meses, percentual_cdi):
    taxa = TAXA_CDI_ANUAL * (percentual_cdi / 100)
    montante = principal * ((1 + taxa) ** (meses / 12))
    rendimento = montante - principal
    return round(montante, 2), round(rendimento, 2)


@simulador_bp.route("/", methods=["GET", "POST"])
@login_required
def simulador():
    resultado = None
    erro = None

    if request.method == "POST":
        try:
            principal      = float(request.form.get("principal", 0))
            meses          = int(request.form.get("meses", 0))
            percentual_cdi = float(request.form.get("percentual_cdi", 100))

            if principal <= 0:
                erro = "O valor investido deve ser maior que zero."
            elif meses <= 0:
                erro = "O período deve ser de pelo menos 1 mês."
            else:
                montante, rendimento = calcular_cdi(principal, meses, percentual_cdi)
                resultado = {
                    "principal":      f"{principal:,.2f}".replace(",", "X").replace(".", ",").replace("X", "."),
                    "montante":       f"{montante:,.2f}".replace(",", "X").replace(".", ",").replace("X", "."),
                    "rendimento":     f"{rendimento:,.2f}".replace(",", "X").replace(".", ",").replace("X", "."),
                    "meses":          meses,
                    "percentual_cdi": percentual_cdi,
                }
        except (ValueError, TypeError):
            erro = "Insira apenas números válidos nos campos."

    return render_template("simulador.html", resultado=resultado, erro=erro)
''')

criar_arquivo("app/routes/cotacoes.py", '''\
"""
app/routes/cotacoes.py
───────────────────────
Rota IoT que busca cotações reais de APIs públicas gratuitas
e as exibe no dashboard do MoneyKids.

APIs utilizadas:
  - BrasilAPI  → CDI, Selic, IPCA (dados do Banco Central)
  - AwesomeAPI → Dólar, Euro, Bitcoin em tempo real
"""

from flask import Blueprint, render_template, jsonify
from flask_login import login_required
import requests
from datetime import datetime

cotacoes_bp = Blueprint("cotacoes", __name__, url_prefix="/cotacoes")

# Tempo máximo de espera por cada API (segundos)
TIMEOUT = 6


def buscar_dolar():
    try:
        r = requests.get(
            "https://economia.awesomeapi.com.br/json/last/USD-BRL",
            timeout=TIMEOUT
        )
        d = r.json()["USDBRL"]
        valor = float(d["bid"])
        variacao = float(d["pctChange"])
        return {
            "valor": f"R$ {valor:.2f}",
            "variacao": f"{variacao:+.2f}%",
            "sinal": "alta" if variacao >= 0 else "baixa",
            "ok": True,
        }
    except Exception:
        return {"valor": "Indisponível", "variacao": "--", "sinal": "neutro", "ok": False}


def buscar_euro():
    try:
        r = requests.get(
            "https://economia.awesomeapi.com.br/json/last/EUR-BRL",
            timeout=TIMEOUT
        )
        d = r.json()["EURBRL"]
        valor = float(d["bid"])
        variacao = float(d["pctChange"])
        return {
            "valor": f"R$ {valor:.2f}",
            "variacao": f"{variacao:+.2f}%",
            "sinal": "alta" if variacao >= 0 else "baixa",
            "ok": True,
        }
    except Exception:
        return {"valor": "Indisponível", "variacao": "--", "sinal": "neutro", "ok": False}


def buscar_bitcoin():
    try:
        r = requests.get(
            "https://economia.awesomeapi.com.br/json/last/BTC-BRL",
            timeout=TIMEOUT
        )
        d = r.json()["BTCBRL"]
        valor = float(d["bid"])
        variacao = float(d["pctChange"])
        return {
            "valor": f"R$ {valor:,.0f}".replace(",", "."),
            "variacao": f"{variacao:+.2f}%",
            "sinal": "alta" if variacao >= 0 else "baixa",
            "ok": True,
        }
    except Exception:
        return {"valor": "Indisponível", "variacao": "--", "sinal": "neutro", "ok": False}


def buscar_cdi():
    try:
        r = requests.get(
            "https://brasilapi.com.br/api/taxas/v1",
            timeout=TIMEOUT
        )
        taxas = r.json()
        cdi = next((t for t in taxas if t.get("nome", "").upper() == "CDI"), None)
        if cdi:
            return {
                "valor": f"{cdi[\'valor\']:.2f}% ao ano",
                "ok": True,
            }
        return {"valor": "Indisponível", "ok": False}
    except Exception:
        return {"valor": "Indisponível", "ok": False}


def buscar_selic():
    try:
        r = requests.get(
            "https://brasilapi.com.br/api/taxas/v1",
            timeout=TIMEOUT
        )
        taxas = r.json()
        selic = next((t for t in taxas if t.get("nome", "").upper() == "SELIC"), None)
        if selic:
            return {
                "valor": f"{selic[\'valor\']:.2f}% ao ano",
                "ok": True,
            }
        return {"valor": "Indisponível", "ok": False}
    except Exception:
        return {"valor": "Indisponível", "ok": False}


def buscar_ipca():
    try:
        r = requests.get(
            "https://brasilapi.com.br/api/taxas/v1",
            timeout=TIMEOUT
        )
        taxas = r.json()
        ipca = next((t for t in taxas if t.get("nome", "").upper() == "IPCA"), None)
        if ipca:
            return {
                "valor": f"{ipca[\'valor\']:.2f}% ao ano",
                "ok": True,
            }
        return {"valor": "Indisponível", "ok": False}
    except Exception:
        return {"valor": "Indisponível", "ok": False}


@cotacoes_bp.route("/")
@login_required
def cotacoes():
    """Página principal com painel de cotações."""
    dados = {
        "dolar":     buscar_dolar(),
        "euro":      buscar_euro(),
        "bitcoin":   buscar_bitcoin(),
        "cdi":       buscar_cdi(),
        "selic":     buscar_selic(),
        "ipca":      buscar_ipca(),
        "atualizado": datetime.now().strftime("%d/%m/%Y às %H:%M:%S"),
    }
    return render_template("cotacoes.html", dados=dados)


@cotacoes_bp.route("/api")
@login_required
def cotacoes_api():
    """Endpoint JSON para atualização via JavaScript (sem recarregar a página)."""
    dados = {
        "dolar":     buscar_dolar(),
        "euro":      buscar_euro(),
        "bitcoin":   buscar_bitcoin(),
        "cdi":       buscar_cdi(),
        "selic":     buscar_selic(),
        "ipca":      buscar_ipca(),
        "atualizado": datetime.now().strftime("%d/%m/%Y às %H:%M:%S"),
    }
    return jsonify(dados)
''')

