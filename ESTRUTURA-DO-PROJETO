"""
Executa todos os testes automatizados do MoneyKids.

Uso:
    python executar_testes.py
    python executar_testes.py auth
    python executar_testes.py simulador
"""
import unittest, sys, time
from datetime import datetime

VERDE="\033[92m"; VERMELHO="\033[91m"; AZUL="\033[94m"; RESET="\033[0m"; NEGRITO="\033[1m"

MODULOS = {
    "auth":      "tests.test_auth",
    "simulador": "tests.test_simulador",
}

def main():
    print(f"\n{AZUL}{NEGRITO}{'═'*50}{RESET}")
    print(f"{AZUL}{NEGRITO}  💰 MoneyKids — Testes Automatizados{RESET}")
    print(f"{AZUL}{'═'*50}{RESET}\n")

    loader = unittest.TestLoader()
    modulo = sys.argv[1] if len(sys.argv) > 1 else None

    if modulo:
        if modulo not in MODULOS:
            print(f"Módulo inválido. Use: {', '.join(MODULOS.keys())}")
            sys.exit(1)
        suite = loader.loadTestsFromName(MODULOS[modulo])
    else:
        suite = unittest.TestSuite()
        for m in MODULOS.values():
            suite.addTests(loader.loadTestsFromName(m))

    inicio = time.time()
    runner = unittest.TextTestRunner(verbosity=2)
    resultado = runner.run(suite)
    tempo = time.time() - inicio

    passou = resultado.testsRun - len(resultado.failures) - len(resultado.errors)
    print(f"\n{AZUL}{'═'*50}{RESET}")
    print(f"  Total: {resultado.testsRun} | {VERDE}Passou: {passou}{RESET} | {VERMELHO}Falhou: {len(resultado.failures)+len(resultado.errors)}{RESET} | Tempo: {tempo:.2f}s")
    print(f"{AZUL}{'═'*50}{RESET}\n")
    sys.exit(0 if resultado.wasSuccessful() else 1)

if __name__ == "__main__":
    main()
''')

